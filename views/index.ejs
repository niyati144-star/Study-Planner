<!DOCTYPE html>
<html>
<head>
    <title>Study Planner - Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <nav class="navbar">
        <h2>Study Planner</h2>
        <div class="nav-links">
            <a href="/">Dashboard</a>
            <a href="/tasks">Tasks</a>
            <a href="/schedule">Schedule</a>
            <a href="/attendance">Attendance</a>
            <a href="/progress">Progress</a>
            <a href="/pomodoro">Pomodoro</a>
        </div>
    </nav>
    <div class="header">
        <h1>My Study Planner</h1>
        <p>
            Plan your study, track your progress and stay consistent.
        </p>
    </div>
    <div class="cards">
        <div class="card">
            <h3>Total Tasks</h3>
            <p><%= tasks.length %></p>
        </div>
        <div class="card">
            <h3>Completed</h3>
            <p><%= completed %></p>
        </div>
        <div class="card">
            <h3>Pending</h3>
            <p><%= pending %></p>
        </div>
        <div class="card">
            <h3>Attendance</h3>
            <p><%= averageAttendance %>%</p>
        </div>
    </div>
    <div class="section">
        <h2>Subject Progress</h2>
        <% subjects.forEach(function(item) { %>
            <div class="subject-progress">
                <div class="progress-title">
                    <b><%= item.name %></b>
                    <span>
                        <%= item.progress %>%
                    </span>
                </div>
                <div class="progress-bar">
                    <div class="progress"></div>
                </div>
            </div>
        <% }); %>
    </div>
    <div class="quick-links">
        <a href="/tasks">
            <b>📝 Manage Tasks</b>
            <span>
                Add, complete and delete study tasks
            </span>
        </a>
        <a href="/schedule">
            <b>📅 Study Schedule</b>
            <span>
                View your weekly study plan
            </span>
        </a>
        <a href="/attendance">
            <b>🎓 Attendance</b>
            <span>
                Track your subject attendance
            </span>
        </a>
        <a href="/pomodoro">
            <b>⏱️ Pomodoro</b>
            <span>
                Focus using a study timer
            </span>
        </a>
    </div>
</div>
</body>
</html>